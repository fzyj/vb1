---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Base64 编码/解码">
  <main class="bg-gray-50 py-10 px-4">
    <div class="mx-auto max-w-2xl">
      <h1 class="text-2xl font-bold text-gray-900 text-center mb-1">
        Base64 编码 / 解码
      </h1>
      <p class="text-sm text-gray-500 text-center mb-8">
        支持文本转换和文件转换
      </p>

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <!-- Tab Bar -->
        <div class="flex border-b border-gray-200 mb-6" id="tabBar">
          <button
            class="px-4 py-2.5 text-sm font-medium border-b-2 border-blue-500 text-blue-600 transition-colors duration-150"
            data-tab="text" id="tabText"
          >
            文本转换
          </button>
          <button
            class="px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 transition-colors duration-150"
            data-tab="file" id="tabFile"
          >
            文件转换
          </button>
        </div>

        <!-- Tab: Text Conversion -->
        <div id="panelText">
          <label class="block text-sm font-medium text-gray-700 mb-1.5">输入</label>
          <textarea
            id="textInput"
            rows="6"
            placeholder="输入要编码/解码的文本..."
            class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-colors resize-y font-mono"
          ></textarea>

          <div class="flex flex-wrap items-center gap-2 my-4">
            <button id="btnEncode" class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 cursor-pointer">
              编码 →
            </button>
            <button id="btnDecode" class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-lg transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 cursor-pointer">
              ← 解码
            </button>
            <button id="btnSwap" class="inline-flex items-center px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-800 hover:bg-gray-100 rounded-lg transition-colors duration-150 cursor-pointer" title="交换输入输出">
              ↕
            </button>
            <div class="flex-1"></div>
            <button id="btnCopyText" class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-lg transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 cursor-pointer">
              复制结果
            </button>
            <span id="copyMsg" class="text-xs text-green-600 hidden ml-1">已复制!</span>
          </div>

          <label class="block text-sm font-medium text-gray-700 mb-1.5">输出</label>
          <textarea
            id="textOutput"
            rows="6"
            readonly
            placeholder="结果将在这里显示..."
            class="w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm outline-none resize-y font-mono"
          ></textarea>
        </div>

        <!-- Tab: File Conversion -->
        <div id="panelFile" class="hidden">
          <!-- File → Base64 -->
          <div class="mb-8">
            <h2 class="text-base font-semibold text-gray-800 mb-3">文件 → Base64</h2>

            <div class="flex items-center gap-3 mb-3">
              <label class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-lg cursor-pointer transition-colors duration-150 focus-within:ring-2 focus-within:ring-blue-500 focus-within:ring-offset-2">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                选择文件
                <input type="file" id="fileInput" class="hidden" />
              </label>
              <span id="fileInfo" class="text-sm text-gray-500 truncate max-w-xs"></span>
            </div>

            <textarea
              id="fileBase64Output"
              rows="6"
              readonly
              placeholder="选择文件后，Base64 结果将显示在这里..."
              class="w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-xs text-gray-600 outline-none resize-y font-mono"
            ></textarea>
            <div class="flex justify-end mt-2">
              <button id="btnCopyFile" class="inline-flex items-center px-3 py-1.5 text-xs font-medium text-gray-600 bg-white border border-gray-300 hover:bg-gray-50 rounded-md transition-colors duration-150 cursor-pointer">
                复制
              </button>
            </div>
          </div>

          <!-- Divider -->
          <hr class="border-gray-200 my-8" />

          <!-- Base64 → File -->
          <div>
            <h2 class="text-base font-semibold text-gray-800 mb-3">Base64 → 文件</h2>

            <label class="block text-sm font-medium text-gray-700 mb-1.5">粘贴 Base64 字符串</label>
            <textarea
              id="decodeBase64Input"
              rows="4"
              placeholder="粘贴 Base64 字符串或 Data URI (data:...;base64,...)..."
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-xs outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors resize-y font-mono"
            ></textarea>

            <label class="block text-sm font-medium text-gray-700 mt-3 mb-1.5">文件名（可选）</label>
            <input
              type="text"
              id="filename"
              placeholder="如不填写将自动推断..."
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors"
            />

            <div class="flex justify-end mt-3">
              <button id="btnDownload" class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-green-600 hover:bg-green-700 rounded-lg transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 cursor-pointer">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                下载文件
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Error Message -->
      <div id="errorMsg" class="mt-4 hidden">
        <p class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2"></p>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  function encodeUtf8ToBase64(text) {
    const bytes = new TextEncoder().encode(text);
    var binary = '';
    for (var i = 0; i < bytes.length; i++) {
      binary += String.fromCharCode(bytes[i]);
    }
    return btoa(binary);
  }

  function decodeBase64ToUtf8(base64) {
    var binary = atob(base64);
    var bytes = new Uint8Array(binary.length);
    for (var i = 0; i < binary.length; i++) {
      bytes[i] = binary.charCodeAt(i);
    }
    return new TextDecoder().decode(bytes);
  }

  function cleanBase64(str) {
    return str.replace(/\s/g, '').replace(/-/g, '+').replace(/_/g, '/');
  }

  function showError(msg) {
    var el = document.getElementById('errorMsg');
    var p = el.querySelector('p');
    p.textContent = msg;
    el.classList.remove('hidden');
    setTimeout(function () { el.classList.add('hidden'); }, 4000);
  }

  function hideError() {
    document.getElementById('errorMsg').classList.add('hidden');
  }

  function formatSize(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
  }

  function copyToClipboard(text, callback) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(callback).catch(function () {
        showError('复制失败');
      });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.left = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand('copy');
        callback();
      } catch (_) {
        showError('复制失败，请手动复制');
      }
      document.body.removeChild(ta);
    }
  }

  // DOM refs
  var tabText = document.getElementById('tabText');
  var tabFile = document.getElementById('tabFile');
  var panelText = document.getElementById('panelText');
  var panelFile = document.getElementById('panelFile');

  var textInput = document.getElementById('textInput');
  var textOutput = document.getElementById('textOutput');
  var btnEncode = document.getElementById('btnEncode');
  var btnDecode = document.getElementById('btnDecode');
  var btnSwap = document.getElementById('btnSwap');
  var btnCopyText = document.getElementById('btnCopyText');
  var copyMsg = document.getElementById('copyMsg');

  var fileInput = document.getElementById('fileInput');
  var fileInfo = document.getElementById('fileInfo');
  var fileBase64Output = document.getElementById('fileBase64Output');
  var btnCopyFile = document.getElementById('btnCopyFile');

  var decodeBase64Input = document.getElementById('decodeBase64Input');
  var filenameInput = document.getElementById('filename');
  var btnDownload = document.getElementById('btnDownload');

  // Tab switching
  document.getElementById('tabBar').addEventListener('click', function (e) {
    var btn = e.target.closest('button');
    if (!btn || !btn.dataset.tab) return;
    var isText = btn.dataset.tab === 'text';
    tabText.className = isText
      ? 'px-4 py-2.5 text-sm font-medium border-b-2 border-blue-500 text-blue-600 transition-colors duration-150'
      : 'px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 transition-colors duration-150';
    tabFile.className = !isText
      ? 'px-4 py-2.5 text-sm font-medium border-b-2 border-blue-500 text-blue-600 transition-colors duration-150'
      : 'px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 transition-colors duration-150';
    panelText.classList.toggle('hidden', !isText);
    panelFile.classList.toggle('hidden', isText);
    hideError();
  });

  // Text encoding
  btnEncode.addEventListener('click', function () {
    var val = textInput.value.trim();
    if (!val) { showError('请输入要编码的文本'); return; }
    hideError();
    textOutput.value = encodeUtf8ToBase64(val);
  });

  // Text decoding
  btnDecode.addEventListener('click', function () {
    var val = textInput.value.trim();
    if (!val) { showError('请输入要解码的 Base64 字符串'); return; }
    hideError();
    try {
      textOutput.value = decodeBase64ToUtf8(cleanBase64(val));
    } catch (_) {
      showError('Base64 解码失败，请检查输入是否为有效的 Base64 字符串');
    }
  });

  // Swap input/output
  btnSwap.addEventListener('click', function () {
    var tmp = textInput.value;
    var outTmp = textOutput.value;
    if (outTmp) {
      textInput.value = outTmp;
      textOutput.value = tmp;
    } else if (tmp) {
      textOutput.value = tmp;
      textInput.value = '';
    }
    hideError();
  });

  // Copy text result
  btnCopyText.addEventListener('click', function () {
    var val = textOutput.value;
    if (!val) { showError('没有可复制的内容'); return; }
    copyToClipboard(val, function () {
      copyMsg.classList.remove('hidden');
      setTimeout(function () { copyMsg.classList.add('hidden'); }, 2000);
    });
  });

  // Copy file base64
  btnCopyFile.addEventListener('click', function () {
    var val = fileBase64Output.value;
    if (!val) { showError('没有可复制的内容'); return; }
    copyToClipboard(val, function () {
      var orig = btnCopyFile.textContent;
      btnCopyFile.textContent = '已复制!';
      setTimeout(function () { btnCopyFile.textContent = orig; }, 2000);
    });
  });

  // File → Base64
  fileInput.addEventListener('change', function () {
    var file = fileInput.files[0];
    if (!file) {
      fileInfo.textContent = '';
      fileBase64Output.value = '';
      return;
    }
    fileInfo.textContent = file.name + ' (' + formatSize(file.size) + ')';
    fileBase64Output.value = '读取中...';
    var reader = new FileReader();
    reader.onload = function () { fileBase64Output.value = reader.result; };
    reader.onerror = function () { showError('文件读取失败'); fileBase64Output.value = ''; };
    reader.readAsDataURL(file);
  });

  // Base64 → File download
  btnDownload.addEventListener('click', function () {
    var raw = decodeBase64Input.value.trim();
    if (!raw) { showError('请粘贴 Base64 字符串'); return; }
    hideError();

    var mimeType = 'application/octet-stream';
    var rawBase64 = raw;
    var filename = filenameInput.value.trim();

    var match = raw.match(/^data:([^;]*)(;base64)?,(.+)$/);
    if (match) {
      mimeType = match[1] || 'application/octet-stream';
      rawBase64 = cleanBase64(match[3]);
    } else {
      rawBase64 = cleanBase64(rawBase64);
    }

    if (!filename) {
      var extMap = {
        'image/png': '.png',
        'image/jpeg': '.jpg',
        'image/gif': '.gif',
        'image/webp': '.webp',
        'image/svg+xml': '.svg',
        'application/pdf': '.pdf',
        'text/plain': '.txt',
        'text/html': '.html',
        'application/json': '.json',
        'application/zip': '.zip',
      };
      filename = 'file' + (extMap[mimeType] || '.bin');
    }

    try {
      var binaryStr = atob(rawBase64);
      var bytes = new Uint8Array(binaryStr.length);
      for (var i = 0; i < binaryStr.length; i++) {
        bytes[i] = binaryStr.charCodeAt(i);
      }
      var blob = new Blob([bytes], { type: mimeType });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    } catch (_) {
      showError('Base64 解码失败，请检查输入是否为有效的 Base64 字符串');
    }
  });
</script>
