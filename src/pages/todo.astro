---
import Layout from '../layouts/Layout.astro';
---

<Layout title="待办清单">
  <main class="bg-gray-50 py-10 px-4">
    <div class="mx-auto max-w-xl">
      <h1 class="text-2xl font-bold text-gray-900 text-center mb-1">
        待办清单
      </h1>
      <p class="text-sm text-gray-500 text-center mb-8">
        管理日常待办事项
      </p>

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <!-- Input row -->
        <div class="flex gap-2 mb-5">
          <input
            id="todoInput"
            type="text"
            placeholder="添加新的待办事项..."
            class="flex-1 min-w-0 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-colors"
          />
          <button
            id="addBtn"
            type="button"
            class="shrink-0 inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors cursor-pointer border-0"
          >
            添加
          </button>
        </div>

        <!-- Filter tabs -->
        <div class="flex gap-1 mb-4 border-b border-gray-200">
          <button class="filter-tab px-3 pb-2 text-sm font-medium border-b-2 border-blue-600 text-blue-600 cursor-pointer bg-transparent" data-filter="all">全部</button>
          <button class="filter-tab px-3 pb-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 cursor-pointer bg-transparent" data-filter="active">未完成</button>
          <button class="filter-tab px-3 pb-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 cursor-pointer bg-transparent" data-filter="completed">已完成</button>
        </div>

        <!-- Todo list -->
        <div id="todoList" class="space-y-1"></div>

        <!-- Empty states -->
        <div id="emptyAll" class="hidden text-center text-sm text-gray-400 py-8">
          暂无待办事项，添加一个开始吧
        </div>
        <div id="emptyActive" class="hidden text-center text-sm text-gray-400 py-8">
          所有事项已完成 🎉
        </div>
        <div id="emptyCompleted" class="hidden text-center text-sm text-gray-400 py-8">
          还没有已完成的事项
        </div>

        <!-- Footer -->
        <div id="footer" class="hidden flex items-center justify-between pt-4 mt-4 border-t border-gray-100">
          <span id="counter" class="text-sm text-gray-500"></span>
          <button
            id="clearCompletedBtn"
            type="button"
            class="text-sm text-gray-500 hover:text-red-600 cursor-pointer bg-transparent border-0 transition-colors"
          >
            清除已完成
          </button>
        </div>
      </div>

      <!-- Error Message -->
      <div id="errorMsg" class="mt-4 hidden">
        <p class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2"></p>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  // ─── Data ────────────────────────────────────────────────────────

  var STORAGE_KEY = 'vb1_todos';
  var todos = [];
  var currentFilter = 'all';

  function loadTodos() {
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      todos = raw ? JSON.parse(raw) : [];
    } catch (_) {
      todos = [];
    }
  }

  function saveTodos() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(todos));
    } catch (_) {}
  }

  // ─── DOM refs ────────────────────────────────────────────────────

  var todoInput = document.getElementById('todoInput');
  var addBtn = document.getElementById('addBtn');
  var todoList = document.getElementById('todoList');
  var emptyAll = document.getElementById('emptyAll');
  var emptyActive = document.getElementById('emptyActive');
  var emptyCompleted = document.getElementById('emptyCompleted');
  var footer = document.getElementById('footer');
  var counter = document.getElementById('counter');
  var clearCompletedBtn = document.getElementById('clearCompletedBtn');
  var filterTabs = document.querySelectorAll('.filter-tab');
  var errorMsg = document.getElementById('errorMsg');

  // ─── Helpers ─────────────────────────────────────────────────────

  function showError(msg) {
    var p = errorMsg.querySelector('p');
    p.textContent = msg;
    errorMsg.classList.remove('hidden');
    setTimeout(function () { errorMsg.classList.add('hidden'); }, 3000);
  }

  function getFilteredTodos() {
    if (currentFilter === 'active') {
      return todos.filter(function (t) { return !t.completed; });
    }
    if (currentFilter === 'completed') {
      return todos.filter(function (t) { return t.completed; });
    }
    return todos;
  }

  var activeCount = function () {
    var count = 0;
    for (var i = 0; i < todos.length; i++) {
      if (!todos[i].completed) count++;
    }
    return count;
  };

  // ─── Render ──────────────────────────────────────────────────────

  function render() {
    var filtered = getFilteredTodos();
    var active = activeCount();

    // Build list HTML
    todoList.innerHTML = '';
    for (var i = 0; i < filtered.length; i++) {
      var t = filtered[i];
      var li = document.createElement('div');
      li.className = 'flex items-center gap-3 px-2 py-2 rounded-lg hover:bg-gray-50 group transition-colors';

      // Checkbox
      var cb = document.createElement('button');
      cb.type = 'button';
      cb.setAttribute('data-action', 'toggle');
      cb.setAttribute('data-id', t.id);
      cb.className = 'shrink-0 w-5 h-5 rounded-full border-2 flex items-center justify-center cursor-pointer bg-transparent p-0 transition-colors ' +
        (t.completed
          ? 'border-green-500 bg-green-500'
          : 'border-gray-300 hover:border-blue-400');

      if (t.completed) {
        cb.innerHTML = '<svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>';
      }

      // Text
      var text = document.createElement('span');
      text.className = 'flex-1 min-w-0 text-sm ' + (t.completed ? 'text-gray-400 line-through' : 'text-gray-800');

      text.textContent = t.text;

      // Delete button
      var del = document.createElement('button');
      del.type = 'button';
      del.setAttribute('data-action', 'delete');
      del.setAttribute('data-id', t.id);
      del.className = 'shrink-0 w-6 h-6 flex items-center justify-center rounded text-gray-400 hover:text-red-500 hover:bg-red-50 opacity-0 group-hover:opacity-100 transition-all cursor-pointer bg-transparent border-0 p-0';
      del.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"></path></svg>';

      li.appendChild(cb);
      li.appendChild(text);
      li.appendChild(del);
      todoList.appendChild(li);
    }

    // Toggle empty states
    var hasItems = todos.length > 0;
    var hasFiltered = filtered.length > 0;

    emptyAll.classList.toggle('hidden', hasItems || currentFilter !== 'all');
    emptyActive.classList.toggle('hidden', hasFiltered || currentFilter !== 'active');
    emptyCompleted.classList.toggle('hidden', hasFiltered || currentFilter !== 'completed');

    // Footer
    if (hasItems) {
      footer.classList.remove('hidden');
      counter.textContent = active + ' 项未完成';
    } else {
      footer.classList.add('hidden');
    }
  }

  function updateFilters() {
    for (var i = 0; i < filterTabs.length; i++) {
      var tab = filterTabs[i];
      var isActive = tab.getAttribute('data-filter') === currentFilter;
      if (isActive) {
        tab.className = 'filter-tab px-3 pb-2 text-sm font-medium border-b-2 border-blue-600 text-blue-600 cursor-pointer bg-transparent';
      } else {
        tab.className = 'filter-tab px-3 pb-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 cursor-pointer bg-transparent';
      }
    }
  }

  // ─── Actions ─────────────────────────────────────────────────────

  function addTodo() {
    var text = todoInput.value.trim();
    if (!text) {
      showError('请输入待办事项内容');
      return;
    }
    todos.push({
      id: Date.now(),
      text: text,
      completed: false,
    });
    todoInput.value = '';
    todoInput.focus();
    saveTodos();
    render();
  }

  function toggleTodo(id) {
    for (var i = 0; i < todos.length; i++) {
      if (todos[i].id === id) {
        todos[i].completed = !todos[i].completed;
        break;
      }
    }
    saveTodos();
    render();
  }

  function deleteTodo(id) {
    todos = todos.filter(function (t) { return t.id !== id; });
    saveTodos();
    render();
  }

  function clearCompleted() {
    todos = todos.filter(function (t) { return !t.completed; });
    saveTodos();
    render();
  }

  function setFilter(filter) {
    currentFilter = filter;
    updateFilters();
    render();
  }

  // ─── Event Listeners ─────────────────────────────────────────────

  addBtn.addEventListener('click', addTodo);

  todoInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
      addTodo();
    }
  });

  todoList.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-action]');
    if (!btn) return;

    var action = btn.getAttribute('data-action');
    var id = Number(btn.getAttribute('data-id'));

    if (action === 'toggle') {
      toggleTodo(id);
    } else if (action === 'delete') {
      deleteTodo(id);
    }
  });

  clearCompletedBtn.addEventListener('click', clearCompleted);

  for (var i = 0; i < filterTabs.length; i++) {
    filterTabs[i].addEventListener('click', function () {
      setFilter(this.getAttribute('data-filter'));
    });
  }

  // ─── Init ────────────────────────────────────────────────────────

  loadTodos();
  render();
</script>
