---
import Layout from '../layouts/Layout.astro';
import { tools } from '../data/tools';
---

<Layout title="工具箱">
	<main class="max-w-5xl mx-auto px-4 py-16">
		<h1 class="text-3xl font-bold text-gray-900 text-center mb-2">开发者工具</h1>
		<p class="text-sm text-gray-500 text-center mb-10">常用在线工具集合</p>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
			{tools.map((tool) => (
				<a
					href={tool.href}
					class="group block rounded-xl border border-gray-200 bg-white p-6 hover:border-blue-300 hover:shadow-md transition-all duration-200 no-underline"
				>
					<div class="text-3xl mb-3">{tool.icon}</div>
					<h2 class="text-lg font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">
						{tool.title}
					</h2>
					<p class="text-sm text-gray-500 mt-1">{tool.desc}</p>
				</a>
			))}
		</div>
	</main>
</Layout>
