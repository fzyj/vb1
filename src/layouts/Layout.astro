---
import '../styles/global.css';
import { tools } from '../data/tools';

interface Props {
	title?: string;
}

const { title = '工具箱' } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
const normalizedPath = (currentPath.replace(base, '') || '/').replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header class="sticky top-0 z-10 bg-white/80 backdrop-blur-sm border-b border-gray-200">
			<div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
				<a href={base + '/'} class="text-lg font-bold text-gray-900 hover:text-blue-600 transition-colors no-underline">
					🧰 工具箱
				</a>
				<nav class="flex items-center gap-1">
					<div class="relative">
						<button
							id="toolsDropdownBtn"
							type="button"
							class="text-sm px-3 py-1.5 rounded-md transition-colors text-gray-600 hover:text-blue-600 hover:bg-gray-50 flex items-center gap-1 border-0 bg-transparent cursor-pointer"
						>
							功能
							<svg id="toolsDropdownArrow" class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
								<path d="M6 9l6 6 6-6"></path>
							</svg>
						</button>
						<div id="toolsDropdownPanel" class="hidden absolute right-0 top-full mt-1 w-auto min-w-36 bg-white rounded-lg shadow-lg border border-gray-200 py-1 whitespace-nowrap">
							{tools.map((tool) => {
								const isActive = normalizedPath === tool.href;
								return (
									<a
										href={base + tool.href}
										class={`block text-sm px-4 py-2 transition-colors ${
											isActive
												? 'text-blue-600 bg-blue-50 font-medium'
												: 'text-gray-600 hover:text-blue-600 hover:bg-gray-50'
										}`}
									>
										<span class="mr-2">{tool.icon}</span>
										{tool.title}
									</a>
								);
							})}
						</div>
					</div>
				</nav>
			</div>
		</header>
		<slot />
	<script is:inline>
		var ddBtn = document.getElementById('toolsDropdownBtn');
		var ddPanel = document.getElementById('toolsDropdownPanel');
		var ddArrow = document.getElementById('toolsDropdownArrow');
		var ddOpen = false;

		function openDropdown() {
			ddPanel.classList.remove('hidden');
			ddArrow.style.transform = 'rotate(180deg)';
			ddOpen = true;
		}

		function closeDropdown() {
			ddPanel.classList.add('hidden');
			ddArrow.style.transform = '';
			ddOpen = false;
		}

		ddBtn.addEventListener('click', function (e) {
			e.stopPropagation();
			if (ddOpen) { closeDropdown(); } else { openDropdown(); }
		});

		document.addEventListener('click', function () {
			if (ddOpen) { closeDropdown(); }
		});
	</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>
