---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Markdown 编辑器">
  <main class="bg-gray-50 py-10 px-4">
    <div class="mx-auto max-w-5xl">
      <h1 class="text-2xl font-bold text-gray-900 text-center mb-1">Markdown 编辑器</h1>
      <p class="text-sm text-gray-500 text-center mb-4">实时预览 Markdown，支持导出 HTML</p>

      <div class="flex flex-wrap items-center justify-center gap-1.5 mb-4">
        <button type="button" data-md="bold" class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-md transition-colors cursor-pointer" title="粗体 (Ctrl+B)">
          <span class="font-bold">B</span>
        </button>
        <button type="button" data-md="italic" class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-md transition-colors cursor-pointer" title="斜体 (Ctrl+I)">
          <span class="italic">I</span>
        </button>
        <button type="button" data-md="heading" class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-md transition-colors cursor-pointer" title="标题">
          H
        </button>
        <span class="w-px h-5 bg-gray-300 mx-0.5"></span>
        <button type="button" data-md="link" class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-md transition-colors cursor-pointer" title="链接">
          🔗
        </button>
        <button type="button" data-md="image" class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-md transition-colors cursor-pointer" title="图片">
          🖼
        </button>
        <span class="w-px h-5 bg-gray-300 mx-0.5"></span>
        <button type="button" data-md="code" class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-md transition-colors cursor-pointer" title="行内代码">
          &lt;/&gt;
        </button>
        <button type="button" data-md="codeblock" class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-md transition-colors cursor-pointer" title="代码块">
          📋
        </button>
        <span class="w-px h-5 bg-gray-300 mx-0.5"></span>
        <button type="button" data-md="ul" class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-md transition-colors cursor-pointer" title="无序列表">
          •≡
        </button>
        <button type="button" data-md="ol" class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-md transition-colors cursor-pointer" title="有序列表">
          1≡
        </button>
        <button type="button" data-md="quote" class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-md transition-colors cursor-pointer" title="引用">
          ❝
        </button>
        <button type="button" data-md="hr" class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-md transition-colors cursor-pointer" title="分隔线">
          —
        </button>
      </div>

      <div class="flex flex-col lg:flex-row gap-4">
        <div class="flex-1 bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="px-3 py-2 border-b border-gray-100 bg-gray-50/50">
            <span class="text-xs font-medium text-gray-500">编辑</span>
            <span id="wordCount" class="text-xs text-gray-400 ml-2"></span>
          </div>
          <textarea
            id="mdInput"
            placeholder="在此输入 Markdown 内容..."
            class="w-full h-[500px] p-4 text-sm text-gray-800 font-mono resize-none outline-none border-0 focus:ring-0"
          ># 欢迎使用 Markdown 编辑器

这是一个 **Markdown** 实时预览工具。

## 功能特性

- 实时预览渲染结果
- 多种格式工具栏
- 复制 HTML / 下载文件

### 代码示例

`行内代码` 和代码块：

```js
function hello() {
  console.log('Hello, Markdown!');
}
```

> 引用文字示例

| 表格 | 支持 |
| ---- | ---- |
| GFM | ✅ |
| 删除线 | ~~text~~ |

[项目地址](https://github.com/anomalyco/opencode)
</textarea
          >
        </div>

        <div class="flex-1 bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="px-3 py-2 border-b border-gray-100 bg-gray-50/50">
            <span class="text-xs font-medium text-gray-500">预览</span>
          </div>
          <div id="mdPreview" class="h-[500px] p-4 overflow-auto prose prose-sm max-w-none">
            <p class="text-sm text-gray-400">正在加载解析器...</p>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-center gap-3 mt-4">
        <button
          id="btnCopy"
          type="button"
          disabled
          class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed rounded-lg transition-colors cursor-pointer"
        >
          复制 HTML
        </button>
        <button
          id="btnDownload"
          type="button"
          disabled
          class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed rounded-lg transition-colors cursor-pointer"
        >
          下载 HTML
        </button>
      </div>

      <div id="errorMsg" class="mt-4 hidden">
        <p class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2"></p>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  var MARKDOWN_IT_VERSION = '14.1.0';
  var MD_IT_URL = 'https://cdn.jsdelivr.net/npm/markdown-it@' + MARKDOWN_IT_VERSION + '/dist/markdown-it.min.js';

  var mdInput = document.getElementById('mdInput');
  var mdPreview = document.getElementById('mdPreview');
  var btnCopy = document.getElementById('btnCopy');
  var btnDownload = document.getElementById('btnDownload');
  var wordCount = document.getElementById('wordCount');
  var errorMsg = document.getElementById('errorMsg');
  var md = null;
  var loading = false;

  function showError(msg) {
    var p = errorMsg.querySelector('p');
    p.textContent = msg;
    errorMsg.classList.remove('hidden');
    setTimeout(function () { errorMsg.classList.add('hidden'); }, 5000);
  }

  function initMarkdown() {
    try {
      md = window.markdownit({
        html: true,
        linkify: true,
        typographer: true,
        breaks: true,
      });
      renderPreview();
      btnCopy.disabled = false;
      btnDownload.disabled = false;
    } catch (e) {
      showError('初始化 Markdown 解析器失败：' + e.message);
    }
  }

  function renderPreview() {
    if (!md) return;
    try {
      var html = md.render(mdInput.value);
      mdPreview.innerHTML = html;
      updateWordCount();
    } catch (e) {
      mdPreview.innerHTML = '<p class="text-sm text-red-500">渲染错误：' + e.message + '</p>';
    }
  }

  function updateWordCount() {
    var text = mdInput.value;
    var chars = text.length;
    wordCount.textContent = chars + ' 字符';
  }

  function loadScript(url, cb) {
    var s = document.createElement('script');
    s.src = url;
    s.onload = function () { cb(true); };
    s.onerror = function () { cb(false); };
    document.head.appendChild(s);
  }

  function loadAllResources(callback) {
    if (loading) return;
    if (md) {
      callback();
      return;
    }
    loading = true;

    function done(ok) {
      if (!ok) {
        showError('加载资源失败，请检查网络连接');
        loading = false;
      } else {
        callback();
      }
    }

    loadScript(MD_IT_URL, done);
  }

  function insertAtCursor(before, after) {
    after = after || '';
    var el = mdInput;
    var start = el.selectionStart;
    var end = el.selectionEnd;
    var text = el.value;
    var selected = text.substring(start, end);
    var replacement = before + selected + after;
    var scrollTop = el.scrollTop;
    var scrollLeft = el.scrollLeft;
    el.value = text.substring(0, start) + replacement + text.substring(end);
    el.focus();
    var newPos = start + before.length + selected.length + after.length;
    if (selected) {
      el.selectionStart = start + before.length;
      el.selectionEnd = start + before.length + selected.length;
    } else {
      el.selectionStart = newPos;
      el.selectionEnd = newPos;
    }
    el.scrollTop = scrollTop;
    el.scrollLeft = scrollLeft;
    renderPreview();
  }

  function insertAtLineStart(prefix) {
    var el = mdInput;
    var start = el.selectionStart;
    var text = el.value;
    var lineStart = text.lastIndexOf('\n', start - 1) + 1;
    var beforeLine = text.substring(0, lineStart);
    var afterLine = text.substring(lineStart);
    var scrollTop = el.scrollTop;
    var scrollLeft = el.scrollLeft;
    el.value = beforeLine + prefix + afterLine;
    el.focus();
    var newPos = lineStart + prefix.length;
    el.selectionStart = newPos;
    el.selectionEnd = newPos;
    el.scrollTop = scrollTop;
    el.scrollLeft = scrollLeft;
    renderPreview();
  }

  document.querySelectorAll('[data-md]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var action = this.getAttribute('data-md');
      switch (action) {
        case 'bold':
          insertAtCursor('**', '**');
          break;
        case 'italic':
          insertAtCursor('*', '*');
          break;
        case 'heading':
          insertAtLineStart('## ');
          break;
        case 'link':
          insertAtCursor('[', '](url)');
          break;
        case 'image':
          insertAtCursor('![', '](url)');
          break;
        case 'code':
          insertAtCursor('`', '`');
          break;
        case 'codeblock':
          insertAtCursor('\n```\n', '\n```\n');
          break;
        case 'ul':
          insertAtLineStart('- ');
          break;
        case 'ol':
          insertAtLineStart('1. ');
          break;
        case 'quote':
          insertAtLineStart('> ');
          break;
        case 'hr':
          insertAtCursor('\n---\n');
          break;
      }
    });
  });

  mdInput.addEventListener('input', function () {
    renderPreview();
  });

  mdInput.addEventListener('keydown', function (e) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'b') {
      e.preventDefault();
      insertAtCursor('**', '**');
    }
    if ((e.ctrlKey || e.metaKey) && e.key === 'i') {
      e.preventDefault();
      insertAtCursor('*', '*');
    }
  });

  btnCopy.addEventListener('click', function () {
    if (!md) return;
    try {
      var html = md.render(mdInput.value);
      navigator.clipboard.writeText(html).then(function () {
        showError('HTML 已复制到剪贴板');
      }).catch(function () {
        var ta = document.createElement('textarea');
        ta.value = html;
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        showError('HTML 已复制到剪贴板');
      });
    } catch (e) {
      showError('复制失败：' + e.message);
    }
  });

  btnDownload.addEventListener('click', function () {
    if (!md) return;
    try {
      var html = md.render(mdInput.value);
      var fullHtml = '<!DOCTYPE html>\n<html lang="zh-CN">\n<head>\n<meta charset="UTF-8">\n<meta name="viewport" content="width=device-width, initial-scale=1.0">\n<title>Markdown 导出</title>\n<style>\nbody{max-width:800px;margin:0 auto;padding:20px;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;line-height:1.6;color:#333;}\npre{background:#f8fafc;padding:16px;border-radius:6px;overflow-x:auto;}\npre code{background:transparent;padding:0;}\ncode:not(pre code){background:#f5f5f5;padding:2px 6px;border-radius:3px;font-size:0.9em;}\ntable{border-collapse:collapse;width:100%;}\nth,td{border:1px solid #ddd;padding:8px 12px;text-align:left;}\nth{background:#f5f5f5;}\nblockquote{border-left:4px solid #ddd;margin:0;padding-left:16px;color:#666;}\nimg{max-width:100%;}\n</style>\n</head>\n<body>\n' + html + '\n</body>\n</html>';
      var blob = new Blob([fullHtml], { type: 'text/html;charset=utf-8' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'markdown-export.html';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    } catch (e) {
      showError('下载失败：' + e.message);
    }
  });

  loadAllResources(initMarkdown);
</script>
