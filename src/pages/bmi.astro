---
import Layout from '../layouts/Layout.astro';
---

<Layout title="BMI 计算器">
  <main class="bg-gray-50 py-10 px-4">
    <div class="mx-auto max-w-md">
      <h1 class="text-2xl font-bold text-gray-900 text-center mb-1">⚖️ BMI 计算器</h1>
      <p class="text-sm text-gray-500 text-center mb-8">身体质量指数（Body Mass Index）</p>

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <form id="bmiForm" class="space-y-5">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5" for="height">
              身高（厘米）
            </label>
            <input
              id="height"
              type="number"
              min="1"
              max="300"
step="1"
               value="170" placeholder="例如 170"
              required
              class="w-full rounded-lg border border-gray-300 px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-shadow"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5" for="weight">
              体重（公斤）
            </label>
            <input
              id="weight"
              type="number"
              min="1"
              max="700"
step="1"
               value="65" placeholder="例如 65"
              required
              class="w-full rounded-lg border border-gray-300 px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-shadow"
            />
          </div>

          <button
            id="calcBtn"
            type="button"
            class="w-full py-2.5 text-sm font-medium text-white rounded-lg transition-colors cursor-pointer border-0"
            style="background-color: #3b82f6;"
          >
            计算
          </button>
        </form>

        <!-- Result -->
        <div id="result" class="mt-6 hidden">
          <div class="border-t border-gray-100 pt-5 text-center">
            <div class="text-4xl font-bold text-gray-900 tabular-nums" id="bmiValue">--</div>
            <div class="mt-1.5">
              <span id="bmiCategory" class="inline-block px-3 py-1 rounded-full text-sm font-medium"></span>
            </div>
            <p id="bmiTip" class="text-xs text-gray-400 mt-2.5"></p>
          </div>
        </div>
      </div>

      <!-- BMI categories reference -->
      <div class="mt-6 bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <h2 class="text-sm font-semibold text-gray-700 mb-3">BMI 参考范围（中国标准）</h2>
        <div class="space-y-1.5 text-xs">
          <div class="flex items-center justify-between py-1.5 px-2 rounded-md" style="background-color: #dbeafe;">
            <span class="text-gray-600">&lt; 18.5</span>
            <span class="font-medium" style="color: #2563eb;">偏瘦</span>
          </div>
          <div class="flex items-center justify-between py-1.5 px-2 rounded-md" style="background-color: #dcfce7;">
            <span class="text-gray-600">18.5 – 23.9</span>
            <span class="font-medium" style="color: #16a34a;">正常</span>
          </div>
          <div class="flex items-center justify-between py-1.5 px-2 rounded-md" style="background-color: #fef3c7;">
            <span class="text-gray-600">24 – 27.9</span>
            <span class="font-medium" style="color: #ca8a04;">偏胖</span>
          </div>
          <div class="flex items-center justify-between py-1.5 px-2 rounded-md" style="background-color: #fce4ec;">
            <span class="text-gray-600">&ge; 28</span>
            <span class="font-medium" style="color: #dc2626;">肥胖</span>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  var heightEl = document.getElementById('height');
  var weightEl = document.getElementById('weight');
  var calcBtn = document.getElementById('calcBtn');
  var resultDiv = document.getElementById('result');
  var bmiValueEl = document.getElementById('bmiValue');
  var bmiCategoryEl = document.getElementById('bmiCategory');
  var bmiTipEl = document.getElementById('bmiTip');

  var CATEGORIES = [
    { max: 18.5, label: '偏瘦', color: '#2563eb', bg: '#dbeafe', tip: '可以适当增加营养和锻炼，增强体质。' },
    { max: 24, label: '正常', color: '#16a34a', bg: '#dcfce7', tip: '体重标准，请继续保持健康的生活方式。' },
    { max: 28, label: '偏胖', color: '#ca8a04', bg: '#fef3c7', tip: '建议控制饮食、增加运动，逐步减重。' },
    { max: Infinity, label: '肥胖', color: '#dc2626', bg: '#fce4ec', tip: '建议咨询医生或营养师，制定科学的减重计划。' },
  ];

  function getCategory(bmi) {
    for (var i = 0; i < CATEGORIES.length; i++) {
      if (bmi < CATEGORIES[i].max) return CATEGORIES[i];
    }
    return CATEGORIES[CATEGORIES.length - 1];
  }

  function calculate() {
    var height = parseFloat(heightEl.value);
    var weight = parseFloat(weightEl.value);

    if (!height || !weight || height <= 0 || weight <= 0) {
      resultDiv.classList.add('hidden');
      return;
    }

    var heightM = height / 100;
    var bmi = weight / (heightM * heightM);
    var roundedBmi = Math.round(bmi * 10) / 10;
    var category = getCategory(bmi);

    bmiValueEl.textContent = roundedBmi;
    bmiCategoryEl.textContent = category.label;
    bmiCategoryEl.style.backgroundColor = category.bg;
    bmiCategoryEl.style.color = category.color;
    bmiTipEl.textContent = category.tip;

    resultDiv.classList.remove('hidden');
  }

  calcBtn.addEventListener('click', calculate);

  heightEl.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') { e.preventDefault(); weightEl.focus(); }
  });

  weightEl.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') { e.preventDefault(); calculate(); }
  });

  // 页面加载时自动计算默认值
  calculate();
</script>
